FROM docker.io/library/ubuntu:24.04 AS os-base
ENV DEBIAN_FRONTEND="noninteractive"

# APL network configuration from
# https://aplprod.servicenowservices.com/sp?id=kb_article&sys_id=c0de6fe91b83d85071b143bae54bcb34
RUN --mount=type=cache,target=/var/lib/apt/lists \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y ca-certificates curl && \
    (curl -sL http://apllinuxdepot.jhuapl.edu/linux/APL-root-cert/JHUAPL-MS-Root-CA-05-21-2038-B64-text.cer -o /usr/local/share/ca-certificates/JHUAPL-MS-Root-CA-05-21-2038-B64-text.crt || true) && \
    update-ca-certificates
ENV PIP_CERT=/etc/ssl/certs/ca-certificates.crt
ENV PIP_DEFAULT_TIMEOUT=300
ENV PIP_BREAK_SYSTEM_PACKAGES=1

# Distro upgrade for security patches
RUN --mount=type=cache,target=/var/lib/apt/lists \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get upgrade -y && \
    rm -f /var/lib/man-db/auto-update

# Testing utilities
RUN --mount=type=cache,target=/var/lib/apt/lists \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y \
    net-tools iproute2 iputils-ping \
    lsof iftop gdb valgrind xxd socat jq ruby && \
    gem install cbor-diag


FROM ubuntu:24.04 AS build-local

RUN --mount=type=cache,target=/var/lib/apt/lists \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y \
    build-essential \
    cmake autoconf libtool && \
    echo "/usr/local/lib" >/etc/ld.so.conf.d/local.conf

COPY deps/QCBOR /usr/local/src/nm/deps/QCBOR
RUN cd /usr/local/src/nm/deps/QCBOR && \
    cmake -S . -B build \
      -DCMAKE_BUILD_TYPE=Debug \
      -DBUILD_SHARED_LIBS=YES && \
    cmake --build build && \
    cmake --install build && \
    ldconfig && \
    rm -rf build

COPY deps/mlib /usr/local/src/nm/deps/mlib
RUN cd /usr/local/src/nm/deps/mlib && \
    make -j$(nproc) && \
    make install && \
    ldconfig && \
    make -j$(nproc) clean

COPY deps/timespec /usr/local/src/nm/deps/timespec
COPY deps/timespec-CMakeLists.txt /usr/local/src/nm/deps/timespec/CMakeLists.txt
RUN cd /usr/local/src/nm/deps/timespec && \
    cmake -S . -B build \
      -DCMAKE_BUILD_TYPE=Debug && \
    cmake --build build && \
    cmake --install build && \
    ldconfig && \
    rm -rf build

# REFDA and REFDM to test
RUN --mount=type=cache,target=/var/lib/apt/lists \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y \
    cmake ninja-build ruby pkg-config \
    flex libfl-dev bison libpcre2-dev libpq-dev civetweb libcivetweb-dev libcjson-dev
COPY cmake /usr/local/src/nm/cmake
COPY src /usr/local/src/nm/src
COPY CMakeLists.txt /usr/local/src/nm/
RUN cd /usr/local/src/nm && \
    cmake -S . -B build/default \
      -DCMAKE_BUILD_TYPE=Debug \
      -DBUILD_ION_PROXY=OFF \
      -DTRANSPORT_UNIX_SOCKET=ON \
      -DTRANSPORT_PROXY_SOCKET=OFF \
      -DTRANSPORT_ION_BP=OFF \
      -DBUILD_UNITTEST=OFF -DBUILD_FUZZING=OFF \
      -DBUILD_DOCS_API=OFF -DBUILD_DOCS_MAN=OFF \
      -G Ninja && \
    cmake --build build/default && \
    cmake --install build/default && \
    ldconfig && \
    rm -rf build


FROM os-base AS client

# Helper utilities
RUN --mount=type=cache,target=/var/lib/apt/lists \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y \
    curl git \
    python3 python3-pip python3-wheel
RUN --mount=type=cache,target=/root/.cache/pip \
    pip3 install schemathesis
RUN --mount=type=cache,target=/root/.cache/pip \
    pip3 install git+https://github.com/JHUAPL-DTNMA/dtnma-ace.git@main
RUN git clone --branch main https://github.com/JHUAPL-DTNMA/dtnma-adms.git /usr/local/share/ace/adms

# test config
COPY integration-test-socket/schemathesis.toml integration-test-socket/serializers.py /root/

WORKDIR "/root"
CMD ["sh", "-c", "trap \"exit\" TERM; while true; do sleep 1; done"]


FROM os-base AS manager

# Test tools
RUN --mount=type=cache,target=/var/lib/apt/lists \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y \
    curl postgresql-client

# REFDM
RUN --mount=type=cache,target=/var/lib/apt/lists \
    --mount=type=cache,target=/var/cache/apt,sharing=locked \
    apt-get update && apt-get install -y \
    libcivetweb1 libcjson1
COPY --from=build-local /usr/local /usr/local
RUN ldconfig
CMD ["sh", "-c", "refdm-socket -l ${DTNMA_LOGLEVEL} -a file:${REFDM_SOCKET}"]

EXPOSE 8089/tcp


FROM os-base AS agent

# Runtime config for this container
COPY integration-test-socket/startup.uri /etc/refda/startup.uri

# REFDA
COPY --from=build-local /usr/local /usr/local
RUN ldconfig
CMD ["sh", "-c", "refda-socket -l ${DTNMA_LOGLEVEL} -s /etc/refda/startup.uri -a file:${REFDA_SOCKET} -m file:${REFDM_SOCKET}"]
